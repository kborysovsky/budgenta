# Copy to .env. Values below are placeholders; never commit real secrets.
POSTGRES_PASSWORD=change-this-local-password
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false

DATA_ENCRYPTION_KEYS=generate-a-fernet-key
IDENTITY_HASH_KEY=replace-with-a-different-random-secret
COINGECKO_API_KEY=

APP_TIMEZONE=America/Argentina/Buenos_Aires

# Native development only; Compose supplies PostgreSQL automatically.
# DATABASE_URL=sqlite:///./budget.db
# STATIC_DIR=/absolute/path/to/frontend/dist
